# Copy to .env (or export these) before running outside local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# Where the master server lives (10.0.2.2 reaches the host from an Android emulator)
SYNC_MASTER_URL=http://localhost:8000
SYNC_DEVICE_ID=POS-1
SYNC_BATCH_SIZE=200
SYNC_SLEEP_INTERVAL=30
# Optional: persistent storage paths when embedded in an app
DJANGO_DB_PATH=
DJANGO_MIGRATIONS_ROOT=
DJANGO_MEDIA_ROOT=
